# Environment variables
.env
.env.*
!.env.example
frontend/.env
frontend/.env.local
frontend/.env.*

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/

# Database & Storage
*.db
*.sqlite3
prototype_core.db
uploads/
logs/
*.log

# Node dependencies & builds
node_modules/
frontend/node_modules/
dist/
frontend/dist/

# Data sheets & heavy files
Builders data/
Excel sheets/
Dubai Hills/
Dubai Hills Raw Work/
Dubai Hills*/
*.xlsx
*.csv
*.xls

# IDE & System files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Agent skills cache
.agents/
skills-lock.json
.claude/

# Private user documentation & PDFs (kept strictly local)
Documentation/
*.pdf

# Local notes that reference accounts or environments. Never committed:
# git history is permanent, so a credential pushed once must be rotated.
*.local.md

# Generated SECRET_KEY for local runs. Never committed.
.secret.local

# Knowledge graph (graphify). The report and the hand-written community labels
# are worth keeping -- the report is readable and diffs sensibly, and the labels
# took real effort to write. Everything else regenerates: the cache, the dated
# backups, the interactive HTML, and .graphify_python, which holds an absolute
# path to whichever machine last built it.
graphify-out/*
!graphify-out/GRAPH_REPORT.md
!graphify-out/.graphify_labels.json
