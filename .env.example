# Copy to .env and fill in. Never commit the real .env.

# --- environment ------------------------------------------------------------
# "development" (default) or "production".
# production makes SECRET_KEY mandatory and refuses to start on SQLite.
APP_ENV=development

# --- security (REQUIRED in production) --------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters. Changing it invalidates all existing logins.
SECRET_KEY=

# How long a login stays valid, in minutes. Default 720 (12 hours).
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Bootstrap administrator, created only on first boot when no admin exists.
# If unset in production no admin is created; use scripts/create_admin.py.
ADMIN_EMAIL=admin@datalink.ae
ADMIN_PASSWORD=

# --- database ---------------------------------------------------------------
# PostgreSQL / Supabase URI. SQLite is for local development only.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/postgres
# Optional read replica for search and dashboard queries.
# READ_DATABASE_URL=

# --- storage ----------------------------------------------------------------
# Uploaded workbooks are re-read when a job is restarted, so this must survive
# a redeploy. On Railway, mount a volume and point this at it.
# UPLOAD_DIR=/data/uploads
# LOG_DIR=/data/logs

# --- processing -------------------------------------------------------------
BATCH_SIZE=1000
RECORD_GRAIN=owner
ENABLE_ENRICHMENT=true

# Minutes without a worker heartbeat before a running job is treated as
# abandoned and marked FAILED at startup.
JOB_STALE_MINUTES=30

# Set to 0 to skip automatic `alembic upgrade head` on boot (if you run
# migrations as a separate deploy step instead).
RUN_MIGRATIONS=1
