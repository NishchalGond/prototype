    "UnifiedNumber"
  ],
  "do_not_map": {
    "Customer Type": "values are PERSON / ORGANIZATION = entity type, NOT buyer/seller. 2,999 rows. Send to extras.",
    "Created by": "CRM user who created the lead - not a property developer. -> extras",
    "Responsible person": "CRM assignee - not a developer. -> extras",
    "Agent": "listing broker - not the developer. -> extras",
    "Name (CRM export)": "record label like \"Owners Data #193265\" - real person is Import - Owner name",
    "Development / Development (Emirate)": "reference-workbook column naming a place, not a building. Routed to enrichment, not records.",
    "Development Type": "reference category (e.g. \"Established organic neighborhood\"), not a sub-community.",
    "FLOOR": "values are floor levels (\"G\", \"22\", \"P\"), not a size. Verified 014 TOWER.xlsx Sheet2.",
    "SHOPS": "building-level unit COUNT (e.g. 2), not a property type. Verified 014 TOWER.xlsx Sheet2.",
    "FLATS": "same as SHOPS - a count, not a property type.",
    "OFFICES": "same as SHOPS - a count, not a property type.",
    "ProcedureNameEn": "transaction procedure description (\"Complete Delayed Sell\"), not a buyer/seller role. Verified Al Barari dec 24.xlsx.",
    "ContractType": "same failure class as ProcedureNameEn - transaction type, not party role.",
    "Proc Type": "same failure class as ProcedureNameEn.",
    "CustomerTypeName": "same family as Customer Type - PERSON/ORGANIZATION entity type, not buyer/seller.",
    "AreaNameEn": "a locality name (\"Wadi Al Safa 3\") -> Community, not a person Name. Verified Al Barari dec 24.xlsx.",
    "Phone 2": "a second phone number -> Mobile 2, not Mobile 1.",
    "BU Name": "a corporate/master-developer entity name (\"Al Furjan (LLC)\") -> Community, not a specific Building/Cluster. Verified Al Furjan_2.xlsx (constant across 3,012 rows).",
    "Property Name": "AMBIGUOUS across files - in Al Furjan_2.xlsx real values are district-level groupings (\"Al Furjan North\", \"Al Furjan West\"), not a single building nor clearly a Project. Left unmapped pending a per-family decision rather than guessed.",
    "United Arab Emirates": "a nationality VALUE, not a header - artifact of a misdetected header row.",
    "Property": "too generic/ambiguous standalone word, real meaning varies by file, can't verify.",
    "PropertyName": "same ambiguity as \"Property Name\" (with space) - left open, not force-mapped.",
    "area_id": "likely an area/community identifier, not a specific plot number - too ambiguous to verify.",
    "VILLA": "bare category word, more often a data VALUE than a real header.",
    "villa": "same as VILLA.",
    "property title": "semantically inconsistent target (title deed concept != Community); their tool's error.",
    "No": "too generic/dangerous - \"No\" collides with unrelated Plot No/Unit No/Reg No contexts elsewhere.",
    "Contact ID": "likely a CRM record identifier, not a phone number - \"ID\" signals a database key.",
    "Client Type": "same failure class as Person Type/Customer Type - verified elsewhere to be occupancy/entity type, not buyer/seller.",
    "Area onwed": "typo of \"Area owned\" - already deliberately excluded (an ownership SHARE, not the unit size). Verified via 014 TOWER joint-ownership analysis.",
    "USAGE": "values are area/usage zones (\"Airport\", \"Residential\"), not dwelling types. 29 sampled rows put 'Airport' into Property Type. -> extras"
  },
  "value_warnings": {
    "TYPE": "mostly Buyer/Seller (3,851 rows) but 141 rows hold A/B/C/D block codes - validate values, don't trust the header"
  },
  "reference_sources": {
    "UAE_Development_Builders.xlsx": "483 UAE developments across 7 emirates. Lookup only - feeds Developer/Community enrichment; never stored as records."
  }
}