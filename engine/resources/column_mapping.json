  "notes": "match on normalized header: strip, collapse whitespace, uppercase, backtick->apostrophe",
  "composite_fields": {
    "Premise 1": {
      "applies_to": "Family A (55 sheets, ~24k rows)",
      "format": "p1 | p2 | p3 | p4  (always exactly 4 parts)",
      "part1": "community code -> Community  (JBR, JLT, BB, PJT, JBR-BCH)",
      "part2": "emirate, always DXB -> drop",
      "part3": "unit -> Unit Number; literal 'NA' in 13,667/24,033 rows",
      "part4": "building -> Building/Cluster (carries the unit too when part3 is NA)",
      "note": "Premise 2 and Premise 3 are empty in every row - do not map"
    },
    "Owners_Phone": {
      "applies_to": "25. _ Tiara (The Palm) _.xls",
      "format": "'Fax 1: x, Mobile 1: y, Other 1: z, Home: w'  - labelled pairs, comma separated",
      "rule": "parse labels; Mobile* -> Mobile 1..3; ignore Fax/Other/Work"
    },
    "Owners_Email": {
      "applies_to": "25. _ Tiara (The Palm) _.xls",
      "format": "comma-separated list",
      "rule": "first -> Email Address, rest -> extras"
    },
    "Person Mail Address": {
      "applies_to": "Family A",
      "format": "{State=DXB, Country=UAE, P.O. Box=...}",
      "rule": "key=value dict, parse or keep raw"
    },
    "community_codes": {
      "JBR": "Jumeirah Beach Residence",
      "JLT": "Jumeirah Lake Towers",
      "BB": "Business Bay",
      "PJT": "Palm Jumeirah",
      "JBR-BCH": "JBR Beach"
    }
  },
